# =============================================================
# Python environment and caches
# =============================================================
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.ipynb_checkpoints/

# =============================================================
# IDE and editor files
# =============================================================
.vscode/
.idea/
*.code-workspace

# =============================================================
# Generated pipeline output (large, regenerated by the scripts)
# =============================================================
processed/
processed_medium/
export_medium_samples/
duckdb_temp*/

# =============================================================
# Large raw datasets (download separately, see README)
# =============================================================
HI-Small_Trans.csv
HI-Small_accounts.csv
HI-Medium_Trans.csv
HI-Medium_accounts.csv

# =============================================================
# Data, model, and database artifacts
# These are ignored by default because the pipeline regenerates
# gigabyte-sized Parquet/CSV files. The small, hand-picked files
# the Streamlit demo actually needs are explicitly un-ignored
# below so they ARE pushed to GitHub (required for deployment).
# =============================================================
*.parquet
*.csv
*.duckdb
*.db
*.sqlite
*.sqlite3

!webapp/sample_data/*.csv

# =============================================================
# Secrets and credentials — never commit these
# =============================================================
.env
.env.*
*.pem
*.key
credentials.json
secrets.json
.streamlit/secrets.toml

# =============================================================
# Runtime logs and temporary files
# =============================================================
*.log
*.tmp
*.bak
*.swp
*.swo

# =============================================================
# OS files
# =============================================================
.DS_Store
Thumbs.db

# =============================================================
# Local notes and chat exports (private planning material)
# =============================================================
chat-readable.md
starting.md
chat.json
